---
import Base from '../../layouts/Base.astro';
import { getWorks, url, type Work } from '../../lib/works';
import { responsive } from '../../lib/media';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((w, i) => ({
    params: { id: w.id },
    props: { w, prev: works[(i + works.length - 1) % works.length], next: works[(i + 1) % works.length], total: works.length },
  }));
}

interface Props { w: Work; prev: Work; next: Work; total: number }
const { w, prev, next, total } = Astro.props;
const d = w.data;
const img = await responsive(w.detail, [480, 720, 1080]);
const wire = w.wireframe ? await responsive(w.wireframe, [300, 600]) : undefined;
const secs = w.sections;
const hasWire = !!wire || secs.length > 0;
const lens = secs.map((s, i) => (secs[i + 1]?.start ?? 100) - s.start);
const catYear = [d.category, d.year].filter(Boolean).join(' · ');
const lead = d.summary || catYear;
const roleLine = [d.roles.join(' · '), d.period].filter(Boolean).join(' · ');
---
<Base title={w.title} description={d.summary || undefined}>
  <div class="pj">
    <div class="head">
      <a class="back" href={url()}>← 전체 작업</a>
      <h1>{w.title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div class="tri">
      <div class="col w">
        {hasWire && (
          <div class="wirebox">
            <h2>구성안</h2>
            {wire ? (
              <div class="wireimg"><img src={wire.src} srcset={wire.srcset} sizes="300px" width={wire.width} height={wire.height} alt="구성안" loading="lazy" /></div>
            ) : (
              <div class="wire">
                {secs.map((s, i) => (
                  <button type="button" data-sec={i} style={`flex-grow:${Math.max(lens[i], 1)}`}>{s.name}</button>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
      <div class="col">
        <div class="phone big">
          <div class="scr" id="scr">
            <img id="detail" src={img.src} srcset={img.srcset} sizes="(max-width:680px) 100vw, 320px" width={img.width} height={img.height} alt={`${w.title} 상세페이지 전체`} fetchpriority="high" />
          </div>
        </div>
        <div class="hint">휴대폰 화면 안에서 스크롤해 보세요</div>
      </div>
      <div class="col">
        <div class="facts">
          {roleLine && <div><small>{d.period ? '담당 범위 · 기간' : '담당 범위'}</small>{roleLine}</div>}
          {d.client && <div><small>작업 형태</small>{d.client}</div>}
          {d.target && <div><small>타깃</small>{d.target}</div>}
          {d.results.map((r) => <div><small>{r.label || '성과'}</small><b class="n">{r.value}</b></div>)}
          {d.summary && catYear && <div><small>분야 · 연도</small>{catYear}</div>}
          {secs.length > 0 && (
            <div class="curnote" id="cur" aria-live="polite">
              <small>지금 보는 섹션 · <span data-cur-name>{secs[0].name}</span></small>
              <span data-cur-note>{secs[0].note}</span>
            </div>
          )}
        </div>
      </div>
    </div>
    {total > 1 && (
      <nav class="pn">
        <a href={url(`works/${prev.id}/`)}>← {prev.title}</a>
        <a href={url(`works/${next.id}/`)}>{next.title} →</a>
      </nav>
    )}
  </div>
  {secs.length > 0 && <script type="application/json" id="secdata" set:html={JSON.stringify(secs)} />}
</Base>

<script>
  const data = document.getElementById('secdata');
  const scr = document.getElementById('scr');
  const imgEl = document.getElementById('detail');
  if (data && scr && imgEl) {
    const secs: { name: string; note: string; start: number }[] = JSON.parse(data.textContent || '[]');
    const wires = [...document.querySelectorAll<HTMLElement>('.wire [data-sec]')];
    const curName = document.querySelector('[data-cur-name]');
    const curNote = document.querySelector('[data-cur-note]');
    const mq = matchMedia('(max-width:680px)');
    let current = -1;
    const set = (i: number) => {
      if (i === current) return;
      current = i;
      wires.forEach((el) => el.classList.toggle('on', Number(el.dataset.sec) === i));
      if (curName) curName.textContent = secs[i].name;
      if (curNote) curNote.textContent = secs[i].note;
    };
    // 화면 가운데 지점이 상세페이지의 몇 % 위치인지 계산
    const pct = () => {
      if (mq.matches) {
        const r = imgEl.getBoundingClientRect();
        return ((innerHeight / 2 - r.top) / r.height) * 100;
      }
      return ((scr.scrollTop + scr.clientHeight / 2) / scr.scrollHeight) * 100;
    };
    const update = () => {
      const p = pct();
      let i = 0;
      secs.forEach((s, k) => {
        if (p >= s.start) i = k;
      });
      set(i);
    };
    let raf = 0;
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    scr.addEventListener('scroll', onScroll, { passive: true });
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    // 구성안 칸을 누르면 그 섹션으로 이동
    wires.forEach((el) =>
      el.addEventListener('click', () => {
        const s = secs[Number(el.dataset.sec)];
        scr.scrollTo({ top: (s.start / 100) * scr.scrollHeight, behavior: 'smooth' });
      }),
    );
    set(0);
  }
</script>

<style>
  .pj{max-width:1240px;margin:auto;padding:12px 28px 100px}
  .pj .back{color:var(--sub);font-size:14px}
  .pj h1{font-size:clamp(28px,4vw,44px);letter-spacing:-.03em;margin:14px 0 6px}
  .pj .lead{color:var(--sub);margin:0}
  .head{margin-bottom:36px}
  .tri{display:grid;grid-template-columns:1fr auto 1fr;gap:40px;align-items:start}
  .col h2{font-size:13px;letter-spacing:.16em;color:var(--sub);margin:0 0 14px}
  .wirebox{max-width:300px;margin-left:auto;position:sticky;top:20px}
  .wireimg{max-height:calc(100vh - 80px);overflow:auto;border:1px dashed #bbb;background:#fafafa}
  .wireimg img{width:100%;height:auto}
  .wire{display:flex;flex-direction:column;gap:8px;height:min(640px,calc(100vh - 80px));padding:9px;background:#fafafa;border:1px dashed #bbb}
  .wire button{flex-basis:0;min-height:30px;border:1.5px solid #c9c9c9;border-radius:6px;background:repeating-linear-gradient(45deg,#f2f2f2 0 6px,#fafafa 6px 12px);font:inherit;font-size:14px;font-weight:700;color:#888;cursor:pointer;transition:.25s;padding:4px}
  .wire button.on{border-color:var(--pt);color:var(--pt);background:color-mix(in srgb,var(--pt) 12%,#fafafa)}
  .big{width:340px;height:min(736px,calc(100vh - 60px))}
  .big .scr{overflow-y:auto;scrollbar-width:none}
  .big .scr::-webkit-scrollbar{display:none}
  .big .scr::before{position:sticky;display:block;margin-bottom:-20px}
  .hint{text-align:center;color:var(--sub);font-size:13px;margin-top:14px}
  .facts{display:grid;gap:12px;position:sticky;top:20px;max-width:340px}
  .facts>div{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;font-size:14px;line-height:1.6}
  .facts small{display:block;color:var(--sub);font-size:12px;margin-bottom:4px}
  .facts b.n{font-size:32px;letter-spacing:-.03em;color:var(--pt);display:block}
  .facts .curnote{border-color:var(--pt)}
  .pn{display:flex;justify-content:space-between;gap:20px;margin-top:56px;font-weight:600}
  @media (max-width:1000px){.tri{grid-template-columns:auto 1fr}.tri .col.w{display:none}}
  @media (max-width:680px){
    .tri{grid-template-columns:1fr}
    .big{width:100%;height:auto;padding:0;background:none;box-shadow:none;border-radius:0;aspect-ratio:auto}
    .big .scr{border-radius:0;height:auto;overflow:visible}
    .big .scr::before{display:none}
    .pj{padding:12px 0 80px}
    .head,.facts,.pn{padding:0 20px}
    .hint{display:none}
    .facts{position:static;max-width:none;margin-top:24px}
  }
</style>
